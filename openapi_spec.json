{
  "openapi": "3.1.0",
  "info": {
    "title": "Federated Feature Selection Agent — Screening API",
    "description": "Fixed-threshold demonstration and in-memory HMAC audit chain. Not a federated learning, secure-aggregation, or clinically validated system.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return in-memory screening counters as JSON",
        "responses": {
          "200": {
            "description": "JSON operational counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate a numeric screening task and record an in-memory HMAC-linked event",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Threshold-screening dossier with HMAC audit hash"
          },
          "422": {
            "description": "Payload validation error or detected sensitive identifier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return a deterministic mock supervisory response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve in-memory signed event metadata (requires AUDIT_API_TOKEN)",
        "responses": {
          "200": {
            "description": "Audit-chain metadata and integrity check"
          },
          "403": {
            "description": "Access token missing, incorrect, or not configured"
          }
        },
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Value must match the configured AUDIT_API_TOKEN"
          }
        ]
      }
    }
  }
}
